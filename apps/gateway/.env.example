OPENAI_API_KEY=sk-...

# 포트 (기본값: 3001)
PORT=3001

# LLM 모델 — 스타키 대화 생성
OPENAI_LLM_MODEL=gpt-4o-mini

# TTS 모델과 보이스 — 로봇 스피커 출력
# response_format: "pcm" 사용 시 24kHz PCM16 반환 (로봇 재생측 주의: 16kHz 아님)
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# 비전 분류 모델 — 카메라 표정 → 미러 리액션
OPENAI_VISION_MODEL=gpt-4o-mini
